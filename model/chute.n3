# -*- Mode: n3 -*-
@prefix :                <https://n3.not.org/2024/09/11#f> .

@prefix chute:           <https://chute.not.org#> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .

@prefix http:            <http://www.ietf.org/rfc/1901#> .

<> 
 :is "N3 triples" .

@prefix dc:              <https://purl.org/dc/elements/1.1/> .
<> 
 dc:created           "15-JAN-2014" ;
 dc:modified          "11-SEP-2024" .

chute:synk
  :a http:get
  :a http:put
  rdfs:label """
The basic verb for use of Chute.

Use it as follows:

On single files:
   synk .emacs

on local collections
   synk .emacs.d/
""" .

chute:plumber
  :a http:post ;
  rdfs:label """
Everything you need for syncs.

Quis custodiet ipsos custodes?
""" .

# Primitives
chute:push
  :a http:put ;
  rdfs:label "Push a local source into your sync.". 

chute:pull
  :a http:get ;
  rdfs:label "Sync local status from a sync.". 

chute:blob
  :a rdf:Bag;
  rdf:_2 _:data ;
  rdf:_3 _:metadata ;
  rdfs:label "Data comes in blobs" .

chute:metadata
  rdfs:label "Blobs have metadata." .

chute:world
  :a chute:fs ;
  :a rdf:Bag ;
  rdf:_0 _:genesis ;
  rdf:_1 _:scratch ;
  rdf:_2 _:first .

chute:snapshot
  :a rdf:Bag ;
  rdf:_2 chute:blob ;
  rdfs:label """
Snapshots of blobs can be created by the process of associating a world with a given time
""" .

chute:contract
  rdfs:label "Blobs are stored under contracts" .

# Architecture
chute:time
  rdfs:label "A monotonically increasing sequence of integers." .
chute:world
  rdfs:seeAlso :mirrorworld ;
  rdfs:label "An collection of blobs ordered by time" .

# Implementations
chute:fs
  rdfs:label "A local collection of FILE and DIRECTORY objects" .

chute:btrfs
  rdfs:comment "Unused" ;
  rdfs:label "An implementation of snapshoting worldlines from BTRFS filesystems." .

chute:zfs
  rdfs:comment "Unimplemented" ;
  rdfs:label "An implementation of snapshoting worldlines from ZFS filesystems." .

# Historical
chute:transfer
  rdfs:comment "No longer necessary with ahistorical adressable naming ?!?"
  rdfs:label "Blobs can be transferred between peers" .

<>
 rdfs:seeAlso <https://github.com/cloudfleet/blimp-parachute/blob/master/model/chute.n3> .
